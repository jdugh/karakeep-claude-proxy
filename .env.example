# Copy to .env, fill in real values, then: chmod 600 .env
# Never commit the real .env file.

# -----------------------------------------------------------------------
# Docker network shared with Karakeep (and Ollama). Do not assume a name;
# set it to whatever your existing external network is actually called.
# -----------------------------------------------------------------------
AI_NETWORK_NAME=CHANGE_ME

# -----------------------------------------------------------------------
# Proxy auth: Karakeep -> this proxy. A local random secret, NOT your
# Claude subscription credential. Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------
PROXY_API_KEY=CHANGE_ME

# -----------------------------------------------------------------------
# Claude authentication: this proxy -> Claude Code.
# Generate on a machine with Claude Code installed: `claude setup-token`
# (do NOT use --bare; see README). This is a different secret from
# PROXY_API_KEY and must never be reused as one.
# -----------------------------------------------------------------------
CLAUDE_CODE_OAUTH_TOKEN=CHANGE_ME

# -----------------------------------------------------------------------
# Model allowlist. No client-supplied model name reaches Claude Code
# directly -- only aliases listed here are accepted.
# -----------------------------------------------------------------------
DEFAULT_MODEL=claude-sonnet
MODEL_MAP=claude-sonnet=sonnet,claude-haiku=haiku,claude-opus=opus

# -----------------------------------------------------------------------
# Runtime behavior
# -----------------------------------------------------------------------
CLAUDE_TIMEOUT_SEC=180
MAX_CONCURRENT_REQUESTS=1
MAX_REQUEST_BODY_BYTES=2097152
MAX_RETRIES=0
LOG_LEVEL=INFO

# Optional admin-only diagnostic endpoint (POST /internal/test-claude),
# protected by PROXY_API_KEY. Off by default; costs quota when enabled.
ENABLE_TEST_CLAUDE_ENDPOINT=false

# Enable WebSearch et WebFetch
# CLAUDE_ENABLE_WEB_TOOLS=true
# CLAUDE_WEB_PROMPT_FILE=/app/prompts/web-tools.txt